*.lnk
.DS_Store

# ---------------------------------------------------------------------------
# Secrets and local config -- never commit these
# A leaked token is abused within minutes, and a rewritten history still
# leaves the secret in the object database and in every clone.
# ---------------------------------------------------------------------------
*.env
.env.*
!.env.example
*.pfx
*.p12
*.snk
secrets.json
appsettings.*.local.json
*secret*
*token*
!*token*.cs
!*Token*.cs
